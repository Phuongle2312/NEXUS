<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ taglib prefix="t" tagdir="/WEB-INF/tags" %>
<%-- Layout tam de chay duoc cac module; task 6 (Gioi) se thay bang layout theo GUI Standards. --%>
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>NEXUS</title>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/app.css">
</head>
<body>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<c:set var="role" value="${sessionScope.user.role}"/>
<header class="topbar">
    <a class="brand" href="${ctx}/dashboard">NEXUS</a>
    <c:if test="${not empty sessionScope.user}">
        <nav>
            <c:if test="${role == 'ADMIN'}">
                <a href="${ctx}/admin/employees">Nhân viên</a>
                <a href="${ctx}/admin/shops">Cửa hàng</a>
                <a href="${ctx}/admin/cities">Thành phố</a>
                <a href="${ctx}/billing/list">Hóa đơn</a>
                <a href="${ctx}/payment/list">Thanh toán</a>
            </c:if>
            <c:if test="${role == 'ACCOUNTS'}">
                <a href="${ctx}/billing/list">Hóa đơn</a>
                <a href="${ctx}/billing/new">Lập hóa đơn</a>
                <a href="${ctx}/billing/overdue">Quá hạn</a>
                <a href="${ctx}/payment/list">Thanh toán</a>
            </c:if>
            <c:if test="${role == 'RETAIL'}">
                <a href="${ctx}/billing/list">Hóa đơn</a>
                <a href="${ctx}/payment/list">Thanh toán</a>
            </c:if>
        </nav>
        <div class="who">
            <c:out value="${sessionScope.user.displayName}"/> (<c:out value="${role}"/>)
            <a href="${ctx}/auth/change-password">Đổi mật khẩu</a>
            <form method="post" action="${ctx}/auth/logout" class="inline">
                <t:csrf/>
                <button type="submit" class="link">Đăng xuất</button>
            </form>
        </div>
    </c:if>
</header>
<main>
<c:if test="${not empty sessionScope.flash}">
    <p class="flash"><c:out value="${sessionScope.flash}"/></p>
    <c:remove var="flash" scope="session"/>
</c:if>
<c:if test="${not empty errorMessage}">
    <p class="error"><c:out value="${errorMessage}"/></p>
</c:if>
