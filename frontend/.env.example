# Địa chỉ gốc của ASP.NET Core Web API (.NET 10).
# Để trống thì client dùng mặc định http://localhost:5080/api.
# Khi chạy qua Vite dev server (đã cấu hình proxy /api), có thể đặt /api để gọi cùng origin.
VITE_API_BASE_URL=http://localhost:5080/api

# Cổng backend cho Vite proxy khi chạy `npm run dev` (mặc định http://localhost:5080).
VITE_API_PROXY_TARGET=http://localhost:5080